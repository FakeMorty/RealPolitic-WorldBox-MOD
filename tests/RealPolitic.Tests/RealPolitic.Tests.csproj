<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS8632</NoWarn>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <IsTestProject>true</IsTestProject>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!--
    Обход для песочницы, где `dotnet test` не находит testhost: кладём runtimeconfig и
    адаптер рядом с тестовой сборкой. Оба пути условные — на обычной машине (и при
    другом NUGET_PACKAGES) цель просто ничего не копирует и сборка не ломается.
  -->
  <PropertyGroup>
    <XunitTestAdapterDll>$(NuGetPackageRoot)xunit.runner.visualstudio/2.8.2/build/net6.0/xunit.runner.visualstudio.testadapter.dll</XunitTestAdapterDll>
  </PropertyGroup>
  <Target Name="CopyTestHostRuntimeConfig" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).runtimeconfig.json" DestinationFiles="$(OutputPath)testhost.runtimeconfig.json" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(XunitTestAdapterDll)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('$(XunitTestAdapterDll)')" />
  </Target>

  <ItemGroup>
    <!-- Тестируем чистое ядро симуляции без ссылок на WorldBox -->
    <Compile Include="../../src/RealPolitic.Core/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
